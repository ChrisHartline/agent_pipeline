# PEFT Training Image for Vertex AI
# Includes PyTorch with CUDA support for A100/L4/T4 GPUs
#
# Build:
#   docker build -f Dockerfile.peft -t gcr.io/<PROJECT>/clara-train:latest .
#
# Push to Artifact Registry:
#   docker push gcr.io/<PROJECT>/clara-train:latest

# Use NVIDIA's PyTorch image with CUDA 12.1 (compatible with A100, L4, T4)
FROM nvcr.io/nvidia/pytorch:24.01-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt /app/requirements.txt

# Install Python packages (PyTorch already included in base image)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    transformers>=4.40.0 \
    datasets>=2.14.0 \
    accelerate>=0.27.0 \
    peft>=0.10.0 \
    trl>=0.8.0 \
    bitsandbytes>=0.43.0 \
    sentencepiece \
    huggingface_hub \
    wandb \
    google-cloud-storage \
    scipy \
    einops \
    flash-attn --no-build-isolation

# Copy application code
COPY scripts/ /app/scripts/
COPY pipeline/ /app/pipeline/
COPY cloud/ /app/cloud/

# Default entrypoint for PEFT training
ENTRYPOINT ["python", "scripts/peft_train.py"]
