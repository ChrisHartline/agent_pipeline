# Clara Memory System - Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# ENCRYPTION (Required for personal data protection)
# =============================================================================
# Generate a key with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CLARA_MEMORY_KEY=your-base64-encoded-32-byte-key-here

# =============================================================================
# SUPABASE (Long-term memory storage)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# =============================================================================
# FALKORDB (Graph database for entity relationships)
# =============================================================================
# For FalkorDB Cloud (get endpoint from your FalkorDB dashboard):
# Format: <endpoint>:<port> from your instance
FALKORDB_HOST=r-xxxxx.instance-xxxxx.hc-xxxxx.us-central1.gcp.xxxxx.cloud
FALKORDB_PORT=55041
FALKORDB_HOSTED_KEY=your-falkordb-api-key

# For local FalkorDB (Docker: docker run -p 6379:6379 falkordb/falkordb):
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_HOSTED_KEY=

# =============================================================================
# GCP (Optional - for Vertex AI integration)
# =============================================================================
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
