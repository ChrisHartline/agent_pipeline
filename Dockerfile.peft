# Dockerfile template for PEFT training image
# Usage: build and push to Artifact Registry (gcr.us-central1-docker.pkg.dev/<PROJECT>/<REPO>/image:tag)

FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip
# NOTE: For GPU images, install the correct torch wheel BEFORE bitsandbytes
# e.g.: pip install torch==<VER>+cu124 -f https://download.pytorch.org/whl/cu124.html
RUN pip install -r /app/requirements.txt

COPY . /app

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/peft_train.py"]
